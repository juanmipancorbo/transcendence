# Same-origin browser configuration (works with localhost and LAN hosts)
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=/api

# Optional Google OAuth (required to demonstrate the OAuth module)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace_with_google_client_id
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=/google

# Public origin used for canonical URLs, sitemap.xml, robots.txt and social
# cards. Must be the absolute, externally reachable origin with no trailing
# slash. Inlined at build time, so changing it requires a rebuild.
NEXT_PUBLIC_SITE_URL=https://localhost
