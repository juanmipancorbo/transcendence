{
	"compilerOptions": {
		"target": "es6",
		"module": "commonjs",
		"rootDir": "./",
		"outDir": "./dist",
		"esModuleInterop": true,
		"strict": true,
    "paths": {
      "@utils/*": ["./src/utils/*"],
      "@endpoints/*": ["./src/endpoints-data/*"],
      "@gameLogic/*": ["./src/logic/*"],
      "@databaseAccess/*": ["./src/database/*"],
    }
	}
}
